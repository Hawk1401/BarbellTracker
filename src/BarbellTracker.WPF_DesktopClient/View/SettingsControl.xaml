<UserControl x:Class="BarbellTracker.WPF_DesktopClient.View.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Margin="12" MaxWidth="520" HorizontalAlignment="Left">
        <TextBlock Text="Analyse" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock Text="Glättung der Positionen (Savitzky-Golay Fenster, 0 = aus)"/>
        <ComboBox ItemsSource="{Binding SmoothingWindows}" SelectedItem="{Binding SmoothingWindow}"
                  Width="80" HorizontalAlignment="Left" Margin="0,4,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,14"
                   Text="Das Tracking zittert um wenige Pixel. Eine stärkere Glättung beruhigt die Kurven, glättet aber auch echte Geschwindigkeitsspitzen."/>

        <TextBlock Text="Mindestbewegung für eine Wiederholung [cm]"/>
        <TextBox Text="{Binding MinRangeOfMotionCm, UpdateSourceTrigger=LostFocus}" Width="80"
                 HorizontalAlignment="Left" Margin="0,4,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="Gray"
                   Text="Kürzere vertikale Bewegungen (Nachfassen, Wippen der Stange, Tracking-Rauschen) zählen nicht als Wiederholung."/>

        <TextBlock Text="Ausgabeordner für CSV-Dateien" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,10"/>
        <TextBlock Text="{Binding EffectiveOutputFolder}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Ordner wählen …" Command="{Binding ChooseOutputFolderCommand}" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Standard" Command="{Binding ResetOutputFolderCommand}" Padding="10,4"/>
        </StackPanel>

        <TextBlock Text="{Binding SaveError}" Foreground="Firebrick" Margin="0,14,0,0" TextWrapping="Wrap"/>
        <TextBlock Foreground="Gray" Margin="0,14,0,0" TextWrapping="Wrap"
                   Text="Die Einstellungen werden automatisch gespeichert."/>

        <TextBlock Text="Info" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,10"/>
        <TextBlock Text="{Binding VersionText}"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Datenordner öffnen" Command="{Binding OpenDataFolderCommand}" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Log-Ordner öffnen" Command="{Binding OpenLogFolderCommand}" Padding="10,4"/>
        </StackPanel>
    </StackPanel>
</UserControl>
